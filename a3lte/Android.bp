// SM-A300FU A300FUXXU1CSG3 /system/lib/libevs_float.so, unmodified.
package { default_applicable_licenses: ["a3lte_evs_blob_license"] }
license {
    name: "a3lte_evs_blob_license",
    license_kinds: ["legacy_proprietary"],
}
cc_prebuilt_library_shared {
    name: "libevs_float",
    srcs: ["proprietary/lib/libevs_float.so"],
    compile_multilib: "32",
    shared_libs: ["libc", "libm", "libstdc++"],
    strip: { none: true },
    // Legacy __aeabi_uldivmod is exported by the device's ARM32 bionic libc
    // (bionic/libc/libc.map.txt), but absent from the build-time stub surface.
    // Native dlopen + 250-frame encode/decode was verified on SM-A300FU.
    allow_undefined_symbols: true,
}

// A3-only generated prebuilt preference: replace the Codec2 AV1 backend inside
// the existing media package without editing framework or APEX sources.
soong_config_module_type {
    name: "a3_software_decoder_prebuilt",
    module_type: "cc_prebuilt_library_shared",
    config_namespace: "a3_media",
    bool_variables: ["native_decoders"],
    properties: ["prefer", "enabled"],
}
a3_software_decoder_prebuilt {
    name: "libcodec2_soft_av1dec_gav1",
    srcs: ["media/prebuilt/libcodec2_soft_av1dec_gav1.so"],
    licenses: ["a3_media_codec_license", "a3_dav1d_license"],
    compile_multilib: "32",
    min_sdk_version: "29",
    apex_available: ["//apex_available:platform", "com.android.media.swcodec"],
    shared_libs: ["libcodec2_soft_common", "libcodec2_vndk", "libcodec2", "libbase", "libcutils", "liblog", "libsfplugin_ccodec_utils", "libstagefright_foundation", "libutils", "libc++", "libc", "libm", "libdl"],
    strip: { none: true },
    prefer: false,
    enabled: false,
    soong_config_variables: { native_decoders: { prefer: true, enabled: true } },
}

a3_software_decoder_prebuilt {
    name: "libcodec2_soft_vp9dec",
    srcs: ["media/prebuilt/libcodec2_soft_vp9dec.so"],
    licenses: ["a3_media_codec_license"],
    compile_multilib: "32",
    min_sdk_version: "29",
    apex_available: ["//apex_available:platform", "com.android.media.swcodec"],
    shared_libs: ["libcodec2_soft_common", "libcodec2_vndk", "libcodec2", "libbase", "libcutils", "liblog", "libsfplugin_ccodec_utils", "libstagefright_foundation", "libutils", "libvpx", "libc++", "libc", "libm", "libdl"],
    strip: { none: true },
    prefer: false,
    enabled: false,
    soong_config_variables: { native_decoders: { prefer: true, enabled: true } },
}
